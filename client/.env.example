# KING DAY STORE — Client Environment Configuration

# Production Backend API URL
# In Vercel Project Settings -> Environment Variables, set VITE_API_URL to your deployed backend URL.
# Example: VITE_API_URL="https://your-backend-service.up.railway.app/api"
#
# In local development, leave empty to automatically use Vite's dev server proxy (/api -> http://localhost:5000)
VITE_API_URL=
