# KING DAY STORE — Environment Configuration

NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection String (Railway / Managed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kingdaydb?schema=public"

# Frontend Application URL
FRONTEND_URL="https://www.king-day.shop"

# JWT Secret Key for Authentication
JWT_SECRET="king-day-production-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# Cloud Object Storage Credentials (S3 / Cloudinary)
STORAGE_PROVIDER="local"
S3_BUCKET="king-day-product-images"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="AKIAXXXXXXXXXXXXXXXX"
S3_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
